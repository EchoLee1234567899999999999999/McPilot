# ============================================================
# McPilot · 麦门决策局 —— 环境变量示例
# ------------------------------------------------------------
# 用法：复制本文件为 .env 后再填写。.env 已被 .gitignore 忽略。
#
# ⚠️ 安全红线（参赛与开源要求）：
#   1. 严禁把真实 MCP Token、Authorization 请求头、账号信息写入本文件并提交。
#   2. 本示例文件中的所有值必须保持为空/占位，不得填入真实凭据。
#   3. 正常使用时，麦当劳 MCP 由 WorkBuddy 连接器托管鉴权，
#      通常无需在此手工配置任何 Token。
# ============================================================

# --- 独立运行（脱离 WorkBuddy）时的 MCP 接入占位 ---
# 留空即可；如确需独立接入，请在本地 .env 中填写，不要提交。
MCD_MCP_ENDPOINT=
MCD_MCP_TOKEN=

# --- 默认偏好（可选，无凭据，可提交）---
# 1=到店自取, 5=得来速
MCD_DEFAULT_BE_TYPE=1
MCD_DEFAULT_CITY=
